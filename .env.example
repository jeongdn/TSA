# 이 파일을 .env로 복사해서 채운다. .env는 .gitignore에 있어 커밋되지 않는다. 키를 채팅이나 코드에 붙여 넣지 않는다.
# OpenAI 호환 API면 어디든 된다.

# (1) OpenAI
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=

# (2) Ollama (무료, 내 PC에서 실행) 예시: 위 세 줄 대신 아래를 쓴다
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=qwen2.5:7b

# CPU에서 돌리는 로컬 모델은 느리므로 응답 대기 시간(초)을 늘릴 수 있다
# OPENAI_TIMEOUT=600
