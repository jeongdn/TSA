# 이 파일을 .env로 복사해서 채운다. .env는 .gitignore에 있어 커밋되지 않는다. 키를 채팅이나 코드에 붙여 넣지 않는다.
# OpenAI 호환 API면 어디든 된다. 같은 이름이 여러 번 있으면 아래쪽 줄의 값이 쓰인다.

# (1) OpenAI
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=

# (2) Ollama (무료, 내 PC에서 실행. NVIDIA GPU가 있으면 자동으로 GPU를 쓴다): 아래 세 줄의 #을 지운다
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=qwen2.5:7b
# Ollama는 문맥 길이가 짧으면 긴 요청의 앞부분(지시문, 도구 설명)을 잘라 버린다. 그래서 Ollama를 켜기 전에
# 이 파일이 아니라 Windows 환경 변수로 OLLAMA_CONTEXT_LENGTH=8192 를 설정한다.

# 응답 대기 시간(초). CPU로 돌리는 로컬 모델은 느리므로 늘린다
# OPENAI_TIMEOUT=600
