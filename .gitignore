.venv/
__pycache__/
*.pyc
.env
.env.*
!.env.example
# 원자료(Comtrade JSON, FRED CSV)는 스크립트로 다시 받는다. 체크섬은 data/manifest.json에 커밋.
# 원자료, 가공 패널, 실제값이 든 예측 파일은 올리지 않는다. 올린 파일 중 실제값이 든 것은 README '이용 조건'과 WORKLOG 17절에 적었다.
data/raw/
data/processed/
outputs/*.csv.gz
# 설정 30개 전체의 예측(진단용)과 에이전트 답변·검토 전문. 답변에는 실제 물량이 들어갈 수 있어 올리지 않는다.
outputs/cache/
# 가린 재검토 묶음 파일 (도구 결과와 실제 물량이 들어 있음, tools/agent_eval/make_blind.py)
blind/
blind_key.json
